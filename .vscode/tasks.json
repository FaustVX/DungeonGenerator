{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/DungeonGenerator.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
			"presentation": {
				"reveal": "silent",
				"close": true,
			},
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/App/DungeonGenerator.App.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/App/DungeonGenerator.App.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "tatr todo",
            "type": "shell",
            "command": "tatr",
            "args": [
                "todo",
                "${file}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
            },
        },
        {
            "label": "tatr ref",
            "type": "shell",
            "command": "tatr",
            "args": [
                "ref"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
            },
            "options": {
                "cwd": "${fileDirname}",
                "statusbar": {
                    "filePattern": "TASK.md",
                },
            },
        },
    ],
}
